{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:best-practices",
        ":semanticCommits",
        ":enableVulnerabilityAlertsWithLabel(security)",
        ":maintainLockFilesWeekly",
        "security:openssf-scorecard",
        "docker:enableMajor",
        "customManagers:githubActionsVersions",
        "customManagers:dockerfileVersions"
    ],
    "timezone": "Europe/Madrid",
    "reviewers": ["pabloimrik17"],
    "labels": ["dependencies"],
    "baseBranchPatterns": ["develop"],
    "dependencyDashboardTitle": "📦 Dependency Dashboard",
    "prConcurrentLimit": 10,
    "prHourlyLimit": 2,
    "minimumReleaseAge": "14 days",
    "rangeStrategy": "pin",
    "osvVulnerabilityAlerts": true,
    "vulnerabilityAlerts": {
        "prHourlyLimit": 0,
        "prConcurrentLimit": 0
    },
    "packageRules": [
        {
            "matchUpdateTypes": ["patch"],
            "schedule": ["on the 1st day of the month"]
        },
        {
            "matchUpdateTypes": ["minor"],
            "schedule": ["on the 8th day of the month every 2 months"]
        },
        {
            "matchUpdateTypes": ["major"],
            "schedule": ["on the 15th day of the month every 3 months"]
        },
        {
            "description": "Seguir versionado de Expo con ~",
            "rangeStrategy": "tilde",
            "matchPackageNames": ["/^expo($|-)/", "/^@expo//"]
        },
        {
            "description": "Keep node engine ranges in libraries instead of pinning. Only node: engines.pnpm is a dev constraint and stays pinned.",
            "matchFileNames": ["packages/**"],
            "matchDepNames": ["node"],
            "rangeStrategy": "replace"
        },
        {
            "description": "Never pin peerDependencies: pinning a peer range leaves consumers a single installable version.",
            "matchDepTypes": ["peerDependencies"],
            "rangeStrategy": "widen"
        },
        {
            "description": "security:minimumReleaseAgeNpm (via config:best-practices) sets npm to 3 days; restore 14 for majors and minors",
            "matchDatasources": ["npm"],
            "matchUpdateTypes": ["major", "minor"],
            "minimumReleaseAge": "14 days"
        },
        {
            "description": "Patches wait 3 days, never below pnpm's minimumReleaseAge (pnpm-workspace.yaml)",
            "matchUpdateTypes": ["patch"],
            "minimumReleaseAge": "3 days"
        },
        {
            "description": "Update the fallow CLI and its GitHub Action together",
            "matchPackageNames": ["fallow", "fallow-rs/fallow"],
            "groupName": "fallow"
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "description": "Update pinned MCP server versions in opencode.json",
            "managerFilePatterns": ["/^opencode\\.json$/"],
            "matchStrings": ["\"(?<depName>@?[^\"@]+)@(?<currentValue>[^\"]+)\""],
            "datasourceTemplate": "npm"
        },
        {
            "customType": "regex",
            "description": "Update pinned MCP server versions in .mcp.json",
            "managerFilePatterns": ["/^\\.mcp\\.json$/"],
            "matchStrings": ["\"(?<depName>@?[^\"@]+)@(?<currentValue>[^\"]+)\""],
            "datasourceTemplate": "npm"
        },
        {
            "customType": "regex",
            "description": "Update pinned CLI tool versions in CI workflows (pnpm dlx/bunx/npx)",
            "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
            "matchStrings": [
                "(?:pnpm dlx|bunx|npx) (?<depName>(?:@[^/\\s]+/)?[^@\\s]+)@(?<currentValue>[^\\s]+)"
            ],
            "datasourceTemplate": "npm"
        },
        {
            "customType": "regex",
            "description": "Update pinned 'pnpm dlx --package <pkg>@<ver>' versions (renovate-config-validator and similar)",
            "managerFilePatterns": [
                "/^\\.github/workflows/.+\\.ya?ml$/",
                "/^lint-staged\\.config\\.ts$/"
            ],
            "matchStrings": [
                "pnpm dlx --package (?<depName>(?:@[^/\\s]+/)?[^@\\s]+)@(?<currentValue>[^\\s]+)"
            ],
            "datasourceTemplate": "npm"
        }
    ]
}
