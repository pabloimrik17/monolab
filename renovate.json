{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:best-practices",
        ":semanticCommits",
        ":enableVulnerabilityAlertsWithLabel(security)",
        ":maintainLockFilesWeekly",
        "security:openssf-scorecard",
        "docker:enableMajor",
        "customManagers:githubActionsVersions",
        "customManagers:dockerfileVersions"
    ],
    "timezone": "Europe/Madrid",
    "reviewers": ["pabloimrik17"],
    "labels": ["dependencies"],
    "baseBranchPatterns": ["develop"],
    "dependencyDashboardTitle": "📦 Dependency Dashboard",
    "prConcurrentLimit": 10,
    "prHourlyLimit": 2,
    "minimumReleaseAge": "14 days",
    "rangeStrategy": "pin",
    "osvVulnerabilityAlerts": true,
    "vulnerabilityAlerts": {
        "prHourlyLimit": 0,
        "prConcurrentLimit": 0
    },
    "packageRules": [
        {
            "matchUpdateTypes": ["patch"],
            "schedule": ["on the 1st day of the month"]
        },
        {
            "matchUpdateTypes": ["minor"],
            "schedule": ["on the 8th day of the month every 2 months"]
        },
        {
            "matchUpdateTypes": ["major"],
            "schedule": ["on the 15th day of the month every 3 months"]
        },
        {
            "description": "Seguir versionado de Expo con ~",
            "rangeStrategy": "replace",
            "matchPackageNames": ["/^expo($|-)/", "/^@expo//"]
        },
        {
            "description": "Keep node engine ranges in libraries instead of pinning. Only node: engines.pnpm is a dev constraint and stays pinned.",
            "matchFileNames": ["packages/**"],
            "matchDepNames": ["node"],
            "rangeStrategy": "replace"
        },
        {
            "description": "Never pin peerDependencies: pinning a peer range leaves consumers a single installable version.",
            "matchDepTypes": ["peerDependencies"],
            "rangeStrategy": "widen"
        },
        {
            "description": "security:minimumReleaseAgeNpm (via config:best-practices) sets npm to 3 days; restore 14 for majors and minors",
            "matchDatasources": ["npm"],
            "matchUpdateTypes": ["major", "minor"],
            "minimumReleaseAge": "14 days"
        },
        {
            "description": "Patches wait 3 days, never below pnpm's minimumReleaseAge (pnpm-workspace.yaml)",
            "matchUpdateTypes": ["patch"],
            "minimumReleaseAge": "3 days"
        },
        {
            "description": "Update the fallow CLI and its GitHub Action together",
            "matchPackageNames": ["fallow", "fallow-rs/fallow"],
            "groupName": "fallow"
        },
        {
            "matchDatasources": ["npm"],
            "matchPackageNames": ["markdownlint", "markdownlint-cli"],
            "groupName": "markdownlint engine, CLI and schema",
            "separateMajorMinor": false
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "description": "Pinned pnpx packages in package.json scripts",
            "managerFilePatterns": ["/(^|/)package\\.json$/"],
            "matchStrings": [
                "\\bpnpx\\s+(?:(?:--package|-p)(?:\\s+|=))?(?<depName>(?:@[a-z0-9_.-]+/)?[a-z0-9_.-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?)(?:$|[\\s\"\\x27`\\\\;|&)\\]}])"
            ],
            "datasourceTemplate": "npm",
            "versioningTemplate": "npm"
        },
        {
            "customType": "regex",
            "description": "Pinned pnpx packages in CI/CD pipelines",
            "managerFilePatterns": [
                "/(^|/)(?:\\.github/workflows|\\.github/actions|\\.eas/workflows)/.*\\.ya?ml$/",
                "/(^|/)(?:bitbucket-pipelines|\\.gitlab-ci|azure-pipelines)\\.ya?ml$/"
            ],
            "matchStrings": [
                "\\bpnpx\\s+(?:(?:--package|-p)(?:\\s+|=))?(?<depName>(?:@[a-z0-9_.-]+/)?[a-z0-9_.-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?)(?:$|[\\s\"\\x27`\\\\;|&)\\]}])"
            ],
            "datasourceTemplate": "npm",
            "versioningTemplate": "npm"
        },
        {
            "customType": "regex",
            "description": "Pinned pnpx packages in Git hooks and their tooling",
            "managerFilePatterns": [
                "/(^|/)\\.husky/[^/]+$/",
                "/(^|/)(?:\\.?lint-?staged(?:\\.config)?\\.(?:[cm]?[jt]s|json)|\\.lintstagedrc(?:\\.(?:[cm]?[jt]s|json|ya?ml))?)$/"
            ],
            "matchStrings": [
                "\\bpnpx\\s+(?:(?:--package|-p)(?:\\s+|=))?(?<depName>(?:@[a-z0-9_.-]+/)?[a-z0-9_.-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?)(?:$|[\\s\"\\x27`\\\\;|&)\\]}])"
            ],
            "datasourceTemplate": "npm",
            "versioningTemplate": "npm"
        },
        {
            "customType": "regex",
            "description": "Pinned pnpx packages in Dockerfiles and Compose files",
            "managerFilePatterns": [
                "/(^|/)(?:Dockerfile(?:\\.[^/]+)?|[^/]+\\.Dockerfile)$/",
                "/(^|/)(?:docker-)?compose(?:\\.[^/]+)?\\.ya?ml$/"
            ],
            "matchStrings": [
                "\\bpnpx\\s+(?:(?:--package|-p)(?:\\s+|=))?(?<depName>(?:@[a-z0-9_.-]+/)?[a-z0-9_.-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?)(?:$|[\\s\"\\x27`\\\\;|&)\\]}])",
                "\\bcommand[\"\\x27]?\\s*[:=]\\s*\\[\\s*\"pnpx\"\\s*,\\s*(?:\"(?:--package|-p)\"\\s*,\\s*)?\"(?<depName>(?:@[a-z0-9_.-]+/)?[a-z0-9_.-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?)\""
            ],
            "datasourceTemplate": "npm",
            "versioningTemplate": "npm"
        },
        {
            "customType": "regex",
            "description": "Pinned pnpx packages in agentic CLI and MCP server configs",
            "managerFilePatterns": [
                "/(^|/)(?:\\.mcp|opencode)\\.json$/",
                "/(^|/)\\.(?:gemini|codex|claude|cursor)/.*\\.(?:jsonc?|toml|ya?ml|[cm]?[jt]s)$/",
                "/(^|/)\\.junie/mcp/mcp\\.json$/"
            ],
            "matchStrings": [
                "\\bpnpx\\s+(?:(?:--package|-p)(?:\\s+|=))?(?<depName>(?:@[a-z0-9_.-]+/)?[a-z0-9_.-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?)(?:$|[\\s\"\\x27`\\\\;|&)\\]}])",
                "\\bcommand[\"\\x27]?\\s*[:=]\\s*\"pnpx\"\\s*,?\\s*[\"\\x27]?args[\"\\x27]?\\s*[:=]\\s*\\[\\s*(?:\"(?:--package|-p)\"\\s*,\\s*)?\"(?<depName>(?:@[a-z0-9_.-]+/)?[a-z0-9_.-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?)\"",
                "\\bcommand[\"\\x27]?\\s*[:=]\\s*\\[\\s*\"pnpx\"\\s*,\\s*(?:\"(?:--package|-p)\"\\s*,\\s*)?\"(?<depName>(?:@[a-z0-9_.-]+/)?[a-z0-9_.-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?)\""
            ],
            "datasourceTemplate": "npm",
            "versioningTemplate": "npm"
        },
        {
            "customType": "regex",
            "description": "Pinned pnpx packages in shell scripts and task runners",
            "managerFilePatterns": ["/\\.(?:sh|bash|zsh)$/", "/(^|/)(?:[Mm]akefile|[Jj]ustfile)$/"],
            "matchStrings": [
                "\\bpnpx\\s+(?:(?:--package|-p)(?:\\s+|=))?(?<depName>(?:@[a-z0-9_.-]+/)?[a-z0-9_.-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?)(?:$|[\\s\"\\x27`\\\\;|&)\\]}])"
            ],
            "datasourceTemplate": "npm",
            "versioningTemplate": "npm"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/^\\.markdownlint\\.jsonc$/"],
            "matchStrings": [
                "\"\\$schema\"\\s*:\\s*\"https://raw\\.githubusercontent\\.com/DavidAnson/markdownlint/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/schema/markdownlint-config-schema\\.json\""
            ],
            "depNameTemplate": "markdownlint",
            "datasourceTemplate": "npm",
            "versioningTemplate": "npm"
        }
    ]
}
