{
    "name": "@m0n0lab/qup-domain",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "pnpm run build:typecheck && pnpm run build:lib",
        "build:lib": "tsdown",
        "build:typecheck": "tsc --noEmit",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "test:unit:coverage": "vitest run --coverage",
        "test:mutation": "stryker run",
        "test:mutation:report": "open reports/mutation/index.html"
    },
    "dependencies": {
        "inversify": "catalog:",
        "neverthrow": "catalog:"
    },
    "devDependencies": {
        "@stryker-mutator/core": "catalog:",
        "@stryker-mutator/typescript-checker": "catalog:",
        "@stryker-mutator/vitest-runner": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=10"
    },
    "packageManager": "pnpm@11.15.0"
}
