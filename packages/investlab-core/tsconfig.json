{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "module": "preserve",
        "moduleResolution": "bundler",
        "outDir": "./out-tsc",
        "rootDir": "./src",
        "declaration": true,
        "composite": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "types": ["node"],
        "paths": {
            "#domain/*": ["./src/domain/*"],
            "#data/*": ["./src/data/*"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["**/*.test.ts", "**/*.spec.ts"],
    "references": [
        {
            "path": "../vitest-config"
        },
        {
            "path": "./tsconfig.node.json"
        },
        {
            "path": "./tsconfig.test.json"
        }
    ]
}
