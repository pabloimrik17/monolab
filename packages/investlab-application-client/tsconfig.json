{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "module": "preserve",
        "moduleResolution": "bundler",
        "outDir": "./out-tsc",
        "rootDir": "./src",
        "declaration": true,
        "composite": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "types": ["node"]
    },
    "include": ["src/**/*"],
    "exclude": ["**/*.test.ts", "**/*.spec.ts"],
    "references": [
      {
        "path": "../investlab-domain"
      },
      {
        "path": "../investlab-core"
      },
      {
        "path": "../vitest-config"
      },
      {
        "path": "../investlab-platform"
      },
      {
        "path": "../investlab-data-contracts"
      },
      {
        "path": "../investlab-data-client"
      },
      {
        "path": "./tsconfig.node.json"
      }
    ]
}
