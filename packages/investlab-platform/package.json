{
    "name": "@m0n0lab/investlab-platform",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.js"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "import": "./dist/client.js"
        },
        "./browser": {
            "types": "./dist/browser.d.ts",
            "import": "./dist/browser.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "build:check-exports": "attw --pack . --profile esm-only",
        "lint:eslint": "eslint --cache --concurrency=auto --max-warnings 40 .",
        "lint:eslint:fix": "eslint --cache --concurrency=auto --max-warnings 40 --fix .",
        "test": "vitest run",
        "test:changed": "vitest run --changed",
        "test:coverage": "vitest run --coverage",
        "test:integration": "vitest run --project integration",
        "test:integration:changed": "vitest run --project integration --changed",
        "test:integration:coverage": "vitest run --project integration --coverage",
        "test:integration:watch": "vitest --project integration",
        "test:unit": "vitest run --project \"unit*\"",
        "test:unit:changed": "vitest run --project \"unit*\" --changed",
        "test:unit:coverage": "vitest run --project \"unit*\" --coverage",
        "test:unit:watch": "vitest --project \"unit*\"",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@m0n0lab/drizzle-neverthrow": "workspace:*",
        "@m0n0lab/investlab-core": "workspace:*",
        "drizzle-orm": "catalog:",
        "inversify": "catalog:",
        "ioredis": "catalog:",
        "neverthrow": "catalog:",
        "pg": "catalog:",
        "zod": "4.6.6"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "catalog:",
        "@m0n0lab/vitest-config": "workspace:*",
        "@testcontainers/postgresql": "catalog:",
        "@types/node": "catalog:",
        "@types/pg": "catalog:",
        "msw": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=22.0.0",
        "pnpm": "12.14.0"
    },
    "packageManager": "pnpm@12.14.0"
}
