{
    "name": "@m0n0lab/investlab-platform",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "exports": {
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.js"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "import": "./dist/client.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "lint:eslint": "eslint --cache --concurrency=auto --max-warnings 40 .",
        "lint:eslint:fix": "eslint --cache --concurrency=auto --max-warnings 40 --fix .",
        "test": "vitest run",
        "test:changed": "vitest run --changed",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "test:unit": "vitest run",
        "test:unit:changed": "vitest run --changed",
        "test:unit:watch": "vitest",
        "test:unit:coverage": "vitest run --coverage",
        "typecheck": "tsc --build tsconfig.json --emitDeclarationOnly"
    },
    "dependencies": {
        "@m0n0lab/drizzle-neverthrow": "workspace:*",
        "@m0n0lab/investlab-core": "workspace:*",
        "drizzle-orm": "catalog:",
        "inversify": "catalog:",
        "ioredis": "catalog:",
        "neverthrow": "catalog:",
        "pg": "catalog:",
        "zod": "3.25.76"
    },
    "devDependencies": {
        "@m0n0lab/vitest-config": "workspace:*",
        "@types/node": "catalog:",
        "@types/pg": "catalog:",
        "msw": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=22.0.0",
        "pnpm": "11.15.0"
    },
    "packageManager": "pnpm@11.15.0"
}
