{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "module": "preserve",
        "moduleResolution": "bundler",
        "outDir": "./out-tsc",
        "rootDir": "./src",
        "declaration": true,
        "composite": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "types": ["node"],
        "paths": {
            "#shared/*": ["./src/shared/*"],
            "#server/*": ["./src/server/*"],
            "#client/*": ["./src/client/*"],
            "#di/*": ["./src/di/*"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["**/*.test.ts", "**/*.spec.ts"],
    "references": [
        {
            "path": "../investlab-core"
        },
        {
            "path": "../drizzle-neverthrow"
        },
        {
            "path": "../vitest-config"
        },
        {
            "path": "./tsconfig.node.json"
        },
        {
            "path": "./tsconfig.test.json"
        }
    ]
}
