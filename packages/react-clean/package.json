{
    "name": "@m0n0lab/react-clean",
    "version": "3.4.0",
    "private": false,
    "author": "Pablo F.G.",
    "repository": {
        "type": "git",
        "url": "https://github.com/pabloimrik17/monolab.git",
        "directory": "packages/react-clean"
    },
    "files": [
        "dist",
        "package.json",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true,
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "pnpm run build:typecheck && pnpm run build:lib",
        "build:check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
        "build:lib": "tsdown",
        "build:typecheck": "tsc --noEmit",
        "lint:eslint": "eslint --cache --concurrency=auto --max-warnings 40 .",
        "lint:eslint:config-check": "eslint-config-prettier src/index.ts",
        "lint:eslint:fix": "eslint --cache --concurrency=auto --max-warnings 40 --fix .",
        "lint:knip": "knip --max-issues 40",
        "lint:knip:fix": "knip --fix",
        "lint:oxfmt": "oxfmt --check .",
        "lint:oxfmt:fix": "oxfmt .",
        "test:browser": "vitest run --browser.enabled=true src/*.browser.test.tsx",
        "test:browser:watch": "vitest --browser.enabled=true src/*.browser.test.tsx",
        "test:integration": "vitest run **/*.integration.ts",
        "test:integration:watch": "vitest **/*.integration.ts",
        "test:mutation": "stryker run",
        "test:mutation:report": "open reports/mutation/index.html",
        "test:types": "vitest --typecheck.enabled --run",
        "test:types:watch": "vitest --typecheck.enabled",
        "test:ui": "vitest --ui",
        "test:unit": "vitest run",
        "test:unit:coverage": "vitest run --coverage",
        "test:unit:watch": "vitest"
    },
    "dependencies": {
        "@m0n0lab/react-hooks": "workspace:*",
        "tslib": "catalog:"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "catalog:",
        "@m0n0lab/ts-types": "workspace:*",
        "@stryker-mutator/api": "catalog:",
        "@types/react": "catalog:",
        "@vitejs/plugin-react-swc": "catalog:",
        "@vitest/browser-playwright": "catalog:",
        "inversify": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "rxjs": "7.8.2",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:",
        "vitest-browser-react": "catalog:"
    },
    "peerDependencies": {
        "inversify": "^6.0.0 || ^7.0.0 || ^8.0.0",
        "react": "^18.0.0 || ^19.0.0",
        "rxjs": "^7.0.0"
    },
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=10"
    },
    "packageManager": "pnpm@11.15.0"
}
