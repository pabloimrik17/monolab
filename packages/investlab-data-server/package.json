{
    "name": "@m0n0lab/investlab-data-server",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./finnhub": {
            "types": "./dist/finnhub.d.ts",
            "import": "./dist/finnhub.js",
            "default": "./dist/finnhub.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "test": "vitest run",
        "test:changed": "vitest run --changed",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "test:unit": "vitest run",
        "test:unit:changed": "vitest run --changed",
        "test:unit:watch": "vitest",
        "test:unit:coverage": "vitest run --coverage",
        "typecheck": "tsc --build tsconfig.json --emitDeclarationOnly"
    },
    "dependencies": {
        "@m0n0lab/investlab-domain": "workspace:*",
        "drizzle-orm": "catalog:",
        "inversify": "catalog:",
        "ioredis": "catalog:",
        "neverthrow": "catalog:",
        "pg": "catalog:"
    },
    "devDependencies": {
        "@m0n0lab/vitest-config": "workspace:*",
        "drizzle-kit": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=22.0.0",
        "pnpm": "11.15.0"
    },
    "packageManager": "pnpm@11.15.0"
}
