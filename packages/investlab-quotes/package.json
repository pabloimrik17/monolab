{
    "name": "@m0n0lab/investlab-quotes",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.js"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "import": "./dist/client.js"
        },
        "./testing": {
            "types": "./dist/testing.d.ts",
            "import": "./dist/testing.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "lint:eslint": "eslint --cache --concurrency=auto --max-warnings 40 .",
        "lint:eslint:fix": "eslint --cache --concurrency=auto --max-warnings 40 --fix .",
        "test": "vitest run",
        "test:changed": "vitest run --changed",
        "test:coverage": "vitest run --coverage",
        "test:integration": "vitest run --project integration:server --project integration:client",
        "test:integration:changed": "vitest run --project integration:server --project integration:client --changed",
        "test:integration:coverage": "vitest run --project integration:server --project integration:client --coverage",
        "test:integration:watch": "vitest --project integration:server --project integration:client",
        "test:unit": "vitest run --project unit",
        "test:unit:changed": "vitest run --project unit --changed",
        "test:unit:coverage": "vitest run --project unit --coverage",
        "test:unit:watch": "vitest --project unit",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@m0n0lab/investlab-core": "workspace:*",
        "@m0n0lab/investlab-platform": "workspace:*",
        "inversify": "catalog:",
        "ioredis": "catalog:",
        "neverthrow": "catalog:",
        "zod": "3.25.76"
    },
    "devDependencies": {
        "@m0n0lab/vitest-config": "workspace:*",
        "@testcontainers/redis": "catalog:",
        "@types/node": "catalog:",
        "msw": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=22.0.0",
        "pnpm": "11.15.0"
    },
    "packageManager": "pnpm@11.15.0"
}
