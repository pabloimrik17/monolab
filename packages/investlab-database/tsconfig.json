{
    "extends": ["../../tsconfig.base.json", "../ts-configs/tsconfig.node24.json"],
    "compilerOptions": {
        "module": "preserve",
        "moduleResolution": "bundler",
        "outDir": "./out-tsc",
        "rootDir": "./src",
        "declaration": true,
        "composite": true,
        "types": ["node"]
    },
    "include": ["src/**/*"],
    "exclude": ["**/*.test.ts", "**/*.spec.ts"],
    "references": [
        {
            "path": "./tsconfig.node.json"
        }
    ]
}
