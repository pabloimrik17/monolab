{
    "name": "@m0n0lab/investlab-database",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "db:generate": "varlock run --path ../../apps/investlab-api/ -- drizzle-kit generate",
        "db:migrate": "varlock run --path ../../apps/investlab-api/ -- drizzle-kit migrate",
        "lint:eslint": "eslint --cache --concurrency=auto --max-warnings 40 .",
        "lint:eslint:fix": "eslint --cache --concurrency=auto --max-warnings 40 --fix ."
    },
    "dependencies": {
        "drizzle-orm": "catalog:",
        "pg": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@types/pg": "catalog:",
        "drizzle-kit": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "varlock": "catalog:"
    },
    "engines": {
        "node": ">=22.0.0",
        "pnpm": "12.14.0"
    },
    "packageManager": "pnpm@12.14.0"
}
