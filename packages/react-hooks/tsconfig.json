{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "module": "preserve",
        "moduleResolution": "bundler",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "outDir": "./out-tsc",
        "rootDir": "./src",
        "declaration": true,
        "composite": true
    },
    "include": ["src/**/*"],
    "exclude": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test-d.ts",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.integration.ts",
        "**/*.integration.tsx"
    ],
    "references": [
        {
            "path": "../vitest-config"
        },
        {
            "path": "./tsconfig.node.json"
        }
    ]
}
