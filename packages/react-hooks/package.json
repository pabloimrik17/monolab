{
    "name": "@m0n0lab/react-hooks",
    "version": "1.4.2",
    "private": false,
    "author": "Pablo F.G.",
    "repository": {
        "type": "git",
        "url": "https://github.com/pabloimrik17/monolab.git",
        "directory": "packages/react-hooks"
    },
    "files": [
        "dist",
        "package.json",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true,
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "tsdown",
        "build:check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
        "lint:eslint": "eslint --cache --concurrency=auto --max-warnings 40 .",
        "lint:eslint:config-check": "eslint-config-prettier src/index.ts",
        "lint:eslint:fix": "eslint --cache --concurrency=auto --max-warnings 40 --fix .",
        "lint:knip": "knip --max-issues 40",
        "lint:knip:fix": "knip --fix",
        "lint:oxfmt": "oxfmt --check .",
        "lint:oxfmt:fix": "oxfmt .",
        "test": "vitest run",
        "test:changed": "vitest run --changed",
        "test:coverage": "vitest run --coverage",
        "test:integration": "vitest run --project integration",
        "test:integration:changed": "vitest run --project integration --changed",
        "test:integration:coverage": "vitest run --project integration --coverage",
        "test:integration:watch": "vitest --project integration",
        "test:mutation": "stryker run",
        "test:mutation:report": "open reports/mutation/index.html",
        "test:types": "vitest run --project types --passWithNoTests",
        "test:types:changed": "vitest run --project types --changed --passWithNoTests",
        "test:types:watch": "vitest --project types",
        "test:ui": "vitest --ui",
        "test:unit": "vitest run --project unit",
        "test:unit:changed": "vitest run --project unit --changed",
        "test:unit:coverage": "vitest run --project unit --coverage",
        "test:unit:watch": "vitest --project unit",
        "test:watch": "vitest"
    },
    "dependencies": {
        "tslib": "catalog:"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "catalog:",
        "@m0n0lab/vitest-config": "workspace:*",
        "@stryker-mutator/api": "catalog:",
        "@types/react": "catalog:",
        "@vitejs/plugin-react-swc": "catalog:",
        "@vitest/browser-playwright": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:",
        "vitest-browser-react": "catalog:"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0"
    },
    "engines": {
        "node": ">=22.0.0",
        "pnpm": "11.15.0"
    },
    "packageManager": "pnpm@11.15.0"
}
