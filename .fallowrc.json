{
    "$schema": "./node_modules/fallow/schema.json",
    "entry": [
        // type-level test files are entries for their assertions
        "**/*.test-d.ts",
        // tool-loaded config (validate-branch-name via husky)
        "validate-branch-name.config.cjs"
    ],
    "ignorePatterns": [
        // agent tooling, not part of the analyzed codebase
        ".opencode/**",
        ".agents/**",
        ".claude/**",
        ".codex/**",
        ".junie/**",
        "claude-plugins/**"
    ],
    "ignoreDependencies": [
        // tool-loaded (stryker resolves plugins at runtime)
        "@stryker-mutator/typescript-checker",
        "@stryker-mutator/vitest-runner",
        // tool-loaded (injected by toolchain)
        "tslib",
        // loaded by eslint-plugin-boundaries through the `import/resolver` setting, never imported
        "eslint-import-resolver-typescript",
        // scoped intent: driver used by drizzle in *-data workspaces only
        "pg",
        // scoped intent: deliberate keep in apps/qup-web (mirrors knip decision)
        "@kobalte/core"
    ],
    "publicPackages": [
        "@m0n0lab/qup-domain",
        "@m0n0lab/solid-clean",
        "@m0n0lab/react-clean",
        "@m0n0lab/drizzle-neverthrow"
    ],
    // zones mirror the eslint-plugin-boundaries layout rules in eslint.config.ts (layer direction, server/client split, app core vs modules); keep both in sync
    "boundaries": {
        "zones": [
            {
                "name": "domain",
                "patterns": ["packages/investlab-*/src/domain/**"]
            },
            {
                "name": "shared-data",
                "patterns": ["packages/investlab-*/src/data/shared/**"]
            },
            {
                "name": "server-application",
                "patterns": ["packages/investlab-*/src/application/server/**"]
            },
            {
                "name": "client-application",
                "patterns": ["packages/investlab-*/src/application/client/**"]
            },
            {
                "name": "server-data",
                "patterns": ["packages/investlab-*/src/data/server/**"]
            },
            {
                "name": "client-data",
                "patterns": ["packages/investlab-*/src/data/client/**"]
            },
            // core/harness boots the app entry, so it stays outside the zone
            {
                "name": "app-core",
                "patterns": [
                    "apps/investlab*/src/core/{route,middleware,mapper,error,page,component,hook,view-model,form}/**"
                ]
            },
            { "name": "app-di", "patterns": ["apps/investlab*/src/di/**"] },
            {
                "name": "app-module",
                "patterns": ["apps/investlab*/src/{catalog,portfolio,quotes,roger}/**"]
            }
        ],
        "rules": [
            { "from": "domain", "allow": [] },
            { "from": "shared-data", "allow": ["domain"] },
            { "from": "server-application", "allow": ["domain"] },
            { "from": "client-application", "allow": ["domain"] },
            {
                "from": "server-data",
                "allow": ["domain", "shared-data", "server-application"]
            },
            {
                "from": "client-data",
                "allow": ["domain", "shared-data", "client-application"]
            },
            // core/ imports packages and di/, never a module (the package zones are listed because fallow rules are allow-lists)
            {
                "from": "app-core",
                "allow": [
                    "app-di",
                    "domain",
                    "shared-data",
                    "server-application",
                    "client-application",
                    "server-data",
                    "client-data"
                ]
            }
        ]
    },
    "duplicates": {
        // type-level test files are per-type assertion boilerplate; clone detection adds no signal there
        "ignore": ["**/*.test-d.ts"]
    },
    // knip parity: type/interface exports referenced in their own file are not dead (e.g. CartItem)
    "ignoreExportsUsedInFile": {
        "type": true,
        "interface": true
    },
    "ignoreUnresolvedImports": [
        // vite public/ asset served from web root
        "/vite.svg"
    ],
    "usedClassMembers": [
        // view-model members are consumed in routes via container.get<T>() + useViewModel;
        // fallow misses member usage through generic receivers (reported upstream)
        { "extends": "BaseViewModel", "members": ["*"] },
        // error `code` discriminant: fallow misses its usage when workspace imports resolve to a built dist/
        { "extends": "Error", "members": ["code"] }
    ],
    "rules": {
        "require-suppression-reason": "warn"
    },
    "overrides": [
        {
            // harnesses come from the generic static `launch()` (`await XHarness.launch()`), whose instance type fallow
            // cannot follow; their members are called by the `*.integration-platform.ts` tests
            "files": [
                "apps/investlab-api/src/core/harness/api.harness.ts",
                "apps/investlab-api/src/**/*.route.harness.ts",
                "apps/investlab/src/core/harness/web.harness.tsx",
                "apps/investlab/src/**/*.page.harness.ts",
                "apps/qup-api/src/harness/api.harness.ts",
                "apps/qup-api/src/**/*.harness.ts"
            ],
            "rules": { "unused-class-members": "off" }
        },
        {
            // `json`/`empty` are called by every module's HTTP repositories through `PLATFORM.InvestlabApiClient` (type-only import `audit` does not follow)
            "files": ["packages/investlab-platform/src/client/http/investlab-api.client.ts"],
            "rules": { "unused-class-members": "off" }
        },
        {
            // `update` is called by the update use cases on the entity `findById` resolves, which fallow cannot type;
            // fallow sees the call only while workspace imports resolve to src (no dist/), so an inline suppression goes stale in one of the two states
            "files": ["packages/investlab-catalog/src/domain/model/instrument.model.ts"],
            "rules": { "unused-class-members": "off" }
        }
    ]
}
