{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "defaultBase": "develop",
    "namedInputs": {
        "default": ["{projectRoot}/**/*", "sharedGlobals"],
        "production": ["default"],
        "sharedGlobals": [
            "{workspaceRoot}/package.json",
            "{workspaceRoot}/pnpm-lock.yaml",
            "{workspaceRoot}/tsconfig.base.json",
            "{workspaceRoot}/packages/ts-configs/tsconfig.base.json",
            "{workspaceRoot}/packages/ts-configs/tsconfig.test.json",
            "{workspaceRoot}/packages/ts-configs/tsconfig.node.*.json",
            "{workspaceRoot}/packages/ts-configs/tsconfig.web.*.json",
            "{workspaceRoot}/nx.json",
            "{workspaceRoot}/.github/workflows/ci.yml"
        ]
    },
    "parallel": 10,
    "nxCloudId": "67f985a4bdd1693cbb6398fa",
    "targetDefaults": {
        "build": {
            "cache": true,
            "dependsOn": ["^build", "typecheck"],
            "inputs": ["default"],
            "outputs": ["{projectRoot}/dist"]
        },
        "build:check-exports": {
            "dependsOn": ["^build", "build", "^build:check-exports"],
            "cache": true,
            "inputs": [
                "production",
                {
                    "dependentTasksOutputFiles": "**/dist/**/*",
                    "transitive": true
                }
            ]
        },
        "dev": {
            "continuous": true,
            "dependsOn": ["^build", "^dev"]
        },
        "lint": {
            "dependsOn": [
                "^lint:eslint",
                "^lint:knip",
                "^lint:markdownlint",
                "^lint:oxfmt",
                "^lint:publint",
                "^lint:stylelint"
            ]
        },
        "lint:eslint": {
            "cache": true,
            "dependsOn": ["^build", "^lint:eslint"],
            "inputs": ["default", "{workspaceRoot}/eslint.config.ts"],
            "outputs": ["{projectRoot}/.eslintcache"]
        },
        "lint:eslint:fix": {
            "dependsOn": ["^build", "^lint:eslint:fix"],
            "inputs": ["default", "{workspaceRoot}/eslint.config.ts"]
        },
        "lint:fallow": {
            "cache": false
        },
        "lint:knip": {
            "cache": true,
            "dependsOn": ["^lint:knip"],
            "inputs": ["default", "{workspaceRoot}/knip.config.ts"]
        },
        "lint:markdownlint": {
            "cache": true,
            "dependsOn": ["^lint:markdownlint"],
            "inputs": ["default", "{workspaceRoot}/.markdownlint*", "{projectRoot}/.markdownlint*"]
        },
        "lint:oxfmt": {
            "cache": true,
            "dependsOn": ["^lint:oxfmt"],
            "inputs": ["default", "{workspaceRoot}/oxfmt.config.ts"]
        },
        "lint:publint": {
            "cache": true,
            "dependsOn": ["^build", "build", "^lint:publint"],
            "inputs": [
                {
                    "json": "{projectRoot}/package.json",
                    "fields": [
                        "name",
                        "version",
                        "main",
                        "module",
                        "types",
                        "exports",
                        "typesVersions",
                        "files",
                        "type",
                        "bin"
                    ]
                },
                "{projectRoot}/dist"
            ]
        },
        "lint:stylelint": {
            "cache": true,
            "dependsOn": ["^lint:stylelint"],
            "inputs": ["default", "{workspaceRoot}/.stylelintrc*", "{projectRoot}/.stylelintrc*"]
        },
        "test": {
            "cache": true,
            "dependsOn": ["^build", "^test"],
            "inputs": [
                "default",
                "^production",
                "{workspaceRoot}/vitest.config.ts",
                "{projectRoot}/vitest.config.ts"
            ],
            "outputs": ["{projectRoot}/html", "{projectRoot}/test-results.junit.xml"]
        },
        "test:coverage": {
            "cache": true,
            "dependsOn": ["^build", "^test:coverage"],
            "inputs": [
                "default",
                "^production",
                "{workspaceRoot}/vitest.config.ts",
                "{projectRoot}/vitest.config.ts"
            ],
            "outputs": [
                "{projectRoot}/coverage",
                "{projectRoot}/html",
                "{projectRoot}/test-results.junit.xml"
            ]
        },
        "test:watch": {
            "continuous": true,
            "dependsOn": ["^build", "^test:watch"]
        },
        "test:changed": {
            "dependsOn": ["^build"]
        },
        "test:unit:changed": {
            "dependsOn": ["^build"]
        },
        "test:types:changed": {
            "dependsOn": ["^build"]
        },
        "test:integration": {
            "dependsOn": ["^build"],
            "cache": true,
            "inputs": [
                "default",
                "^production",
                "{workspaceRoot}/vitest.config.ts",
                "{projectRoot}/vitest.config.ts"
            ],
            "outputs": ["{projectRoot}/html", "{projectRoot}/test-results.junit.xml"]
        },
        "test:integration:changed": {
            "dependsOn": ["^build"]
        },
        "test:integration:coverage": {
            "dependsOn": ["^build"],
            "cache": true,
            "inputs": [
                "default",
                "^production",
                "{workspaceRoot}/vitest.config.ts",
                "{projectRoot}/vitest.config.ts"
            ],
            "outputs": [
                "{projectRoot}/test-results.junit.xml",
                "{projectRoot}/coverage",
                "{projectRoot}/html"
            ]
        },
        "test:types:watch": {
            "continuous": true,
            "dependsOn": ["^build"]
        },
        "test:integration:watch": {
            "continuous": true,
            "dependsOn": ["^build"]
        },
        "test:types": {
            "cache": true,
            "dependsOn": ["^build", "^test:types"],
            "inputs": [
                "default",
                "^production",
                "{workspaceRoot}/vitest.config.ts",
                "{projectRoot}/vitest.config.ts"
            ],
            "outputs": ["{projectRoot}/test-results.junit.xml"]
        },
        "test:unit": {
            "cache": true,
            "dependsOn": ["^build", "^test:unit"],
            "inputs": [
                "default",
                "^production",
                "{workspaceRoot}/vitest.config.ts",
                "{projectRoot}/vitest.config.ts"
            ],
            "outputs": ["{projectRoot}/html", "{projectRoot}/test-results.junit.xml"]
        },
        "test:unit:coverage": {
            "cache": true,
            "dependsOn": ["^build", "^test:unit:coverage"],
            "inputs": [
                "default",
                "^production",
                "{workspaceRoot}/vitest.config.ts",
                "{projectRoot}/vitest.config.ts"
            ],
            "outputs": [
                "{projectRoot}/coverage",
                "{projectRoot}/html",
                "{projectRoot}/test-results.junit.xml"
            ]
        },
        "test:unit:watch": {
            "continuous": true,
            "dependsOn": ["^build", "^test:unit:watch"],
            "inputs": [
                "default",
                "^production",
                "{workspaceRoot}/vitest.config.ts",
                "{projectRoot}/vitest.config.ts"
            ],
            "outputs": ["{projectRoot}/coverage", "{projectRoot}/html"]
        },
        "test:integration-platform": {
            "cache": true,
            "dependsOn": ["^build"],
            "inputs": [
                "default",
                "^production",
                "{workspaceRoot}/vitest.config.ts",
                "{projectRoot}/vitest.config.ts"
            ],
            "outputs": ["{projectRoot}/html", "{projectRoot}/test-results.junit.xml"]
        },
        "test:integration-platform:coverage": {
            "cache": true,
            "dependsOn": ["^build"],
            "inputs": [
                "default",
                "^production",
                "{workspaceRoot}/vitest.config.ts",
                "{projectRoot}/vitest.config.ts"
            ],
            "outputs": [
                "{projectRoot}/coverage",
                "{projectRoot}/html",
                "{projectRoot}/test-results.junit.xml"
            ]
        },
        "test:integration-platform:watch": {
            "continuous": true,
            "dependsOn": ["^build"],
            "inputs": [
                "default",
                "^production",
                "{workspaceRoot}/vitest.config.ts",
                "{projectRoot}/vitest.config.ts"
            ],
            "outputs": ["{projectRoot}/coverage", "{projectRoot}/html"]
        },
        "test:integration-platform:changed": {
            "dependsOn": ["^build"]
        },
        "test:mutation": {
            "cache": true,
            "dependsOn": ["^build", "build"],
            "inputs": [
                "default",
                "^production",
                "{workspaceRoot}/stryker.config.base.mjs",
                "{projectRoot}/stryker.config.mjs",
                "{projectRoot}/reports/stryker-incremental.json"
            ],
            "outputs": [
                "{projectRoot}/reports/mutation",
                "{projectRoot}/reports/stryker-incremental.json"
            ]
        },
        "test:mutation:report": {
            "cache": false
        },
        "typecheck": [
            {
                "dependsOn": ["^typecheck", "^build"]
            },
            {
                "filter": {
                    "plugin": "@nx/js/typescript"
                },
                "inputs": ["...", "sharedGlobals"]
            }
        ],
        "lint:eslint:config-check": {
            "cache": true,
            "inputs": ["default", "{workspaceRoot}/eslint.config.ts"]
        }
    },
    "sync": {
        "applyChanges": true
    },
    "plugins": [
        {
            "plugin": "@nx/js/typescript",
            "options": {
                "typecheck": {
                    "targetName": "typecheck"
                },
                "build": {
                    "targetName": "build",
                    "configName": "tsconfig.lib.json",
                    "buildDepsName": "build-deps",
                    "watchDepsName": "watch-deps"
                }
            }
        }
    ],
    "analytics": false,
    "maxCacheSize": "1GB"
}
