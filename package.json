{
    "name": "@m0n0lab/source",
    "version": "2.0.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "demo:dev": "nx run @m0n0lab/demo:dev",
        "qup:build": "nx run-many -t build -p @m0n0lab/qup-api @m0n0lab/qup-web",
        "qup:dev": "nx run-many -t dev -p @m0n0lab/qup-api @m0n0lab/qup-web",
        "qup:test": "nx run-many -t test:unit -p @m0n0lab/qup-domain @m0n0lab/qup-data @m0n0lab/qup-api",
        "investlab:build": "nx run-many -t build -p @m0n0lab/investlab @m0n0lab/investlab-domain @m0n0lab/investlab-data @m0n0lab/investlab-core",
        "investlab:dev": "nx run-many -t dev -p @m0n0lab/investlab",
        "investlab:test": "nx run-many -t test:unit -p @m0n0lab/investlab-domain @m0n0lab/investlab-data @m0n0lab/investlab-core",
        "jsr:sync-version": "node tools/sync-jsr-version.js",
        "lint:knip": "knip --max-issues 40",
        "lint:knip:fix": "knip --fix",
        "lint:oxfmt": "oxfmt --check",
        "lint:oxfmt:fix": "oxfmt",
        "monorepo:clean:dist": "pnpm dlx rimraf@5.0.10 -g \"**/dist\"",
        "monorepo:clean:eslintcache": "pnpm dlx rimraf@5.0.10 -g \"**/.eslintcache\"",
        "monorepo:clean:hard": "pnpm run monorepo:clean:soft && pnpm run monorepo:clean:dist && pnpm run monorepo:clean:node_modules",
        "monorepo:clean:node_modules": "pnpm dlx rimraf@5.0.10 -g \"**/node_modules\"",
        "monorepo:clean:nx": "nx reset",
        "monorepo:clean:soft": "pnpm run monorepo:clean:tsbuildinfo && pnpm run monorepo:clean:eslintcache && pnpm run monorepo:clean:nx",
        "monorepo:clean:tsbuildinfo": "pnpm dlx rimraf@5.0.10 -g \"**/tsconfig.tsbuildinfo\"",
        "mutation:test": "nx run-many --target=mutation:test",
        "mutation:test:affected": "nx affected --target=mutation:test",
        "prepare": "husky",
        "react-clean:release": "nx release --skip-publish --projects @m0n0lab/react-clean && pnpm run jsr:sync-version",
        "react-clean:release:dry": "nx release --skip-publish --dry-run --projects @m0n0lab/react-clean",
        "react-hooks:release": "nx release --skip-publish --projects @m0n0lab/react-hooks && pnpm run jsr:sync-version",
        "react-hooks:release:dry": "nx release --skip-publish --dry-run --projects @m0n0lab/react-hooks",
        "setup:browsers": "playwright install chromium",
        "test:browser": "nx run-many --target=test:browser",
        "test:browser:affected": "nx affected --target=test:browser",
        "test:integration": "nx run-many --target=test:integration",
        "test:integration:affected": "nx affected --target=test:integration",
        "test:integration:watch": "nx run-many --target=test:integration:watch",
        "test:types": "nx run-many --target=test:types",
        "test:types:affected": "nx affected --target=test:types",
        "test:types:watch": "nx run-many --target=test:types:watch",
        "test:ui": "vitest --ui",
        "test:unit": "nx run-many --target=test:unit",
        "test:unit:affected": "nx affected --target=test:unit",
        "test:unit:watch": "nx run-many --target=test:unit:watch"
    },
    "devDependencies": {
        "@codecov/bundle-analyzer": "2.0.1",
        "@codecov/rollup-plugin": "2.0.1",
        "@codecov/sveltekit-plugin": "2.0.1",
        "@codecov/vite-plugin": "2.0.1",
        "@commitlint/cli": "21.1.0",
        "@commitlint/config-conventional": "21.1.0",
        "@commitlint/types": "21.1.0",
        "@eslint/js": "10.0.1",
        "@nx/js": "23.0.1",
        "@stryker-mutator/core": "9.6.1",
        "@stryker-mutator/typescript-checker": "9.6.1",
        "@stryker-mutator/vitest-runner": "9.6.1",
        "@swc-node/register": "1.11.1",
        "@swc/core": "1.15.41",
        "@swc/helpers": "0.5.23",
        "@types/node": "24.13.2",
        "@vitejs/plugin-react-swc": "4.3.1",
        "@vitest/browser": "4.1.9",
        "@vitest/browser-playwright": "4.1.9",
        "@vitest/coverage-v8": "catalog:",
        "@vitest/ui": "catalog:",
        "eslint": "10.5.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-regexp": "3.1.1",
        "globals": "17.7.0",
        "husky": "9.1.7",
        "knip": "5.88.1",
        "lint-staged": "17.0.8",
        "markdownlint-cli": "0.48.0",
        "nx": "23.0.1",
        "oxfmt": "0.54.0",
        "playwright": "1.60.0",
        "stylelint": "17.14.0",
        "stylelint-config-standard": "40.0.0",
        "tslib": "2.8.1",
        "typescript": "6.0.3",
        "typescript-eslint": "8.61.0",
        "validate-branch-name": "1.3.2",
        "vite-tsconfig-paths": "catalog:",
        "vitest": "catalog:"
    },
    "devEngines": {
        "runtime": [
            {
                "name": "deno",
                "version": "2.6.4",
                "onFail": "download"
            },
            {
                "name": "node",
                "version": "24.12.0",
                "onFail": "download"
            }
        ]
    },
    "engines": {
        "deno": "2.6.4",
        "node": "24.12.0",
        "pnpm": "10.27.0"
    },
    "packageManager": "pnpm@10.27.0"
}
