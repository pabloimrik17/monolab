{
    "name": "@m0n0lab/source",
    "version": "2.0.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "qup:build": "nx run-many -t build -p @m0n0lab/qup-api @m0n0lab/qup-web",
        "qup:dev": "nx run-many -t dev -p @m0n0lab/qup-api @m0n0lab/qup-web",
        "qup:test": "nx run-many -t test -p @m0n0lab/qup-domain @m0n0lab/qup-data @m0n0lab/qup-api",
        "investlab:build": "nx run-many -t build -p @m0n0lab/investlab @m0n0lab/investlab-api",
        "investlab:dev": "nx run-many -t dev -p @m0n0lab/investlab @m0n0lab/investlab-api",
        "investlab:test": "nx run-many -t test -p @m0n0lab/investlab @m0n0lab/investlab-api",
        "lint:fallow": "fallow dead-code --fail-on-issues",
        "lint:knip": "knip --max-issues 60",
        "lint:legacy-tests": "git ls-files '*.legacy.test.*' | diff docs/legacy-tests.txt -",
        "lint:knip:fix": "knip --fix",
        "lint:markdownlint": "markdownlint .",
        "lint:oxfmt": "oxfmt --check",
        "lint:oxfmt:fix": "oxfmt",
        "monorepo:clean:dist": "pnpm dlx rimraf@5.0.10 -g \"**/dist\"",
        "monorepo:clean:eslintcache": "pnpm dlx rimraf@5.0.10 -g \"**/.eslintcache\"",
        "monorepo:clean:hard": "pnpm run monorepo:clean:soft && pnpm run monorepo:clean:dist && pnpm run monorepo:clean:node_modules",
        "monorepo:clean:node_modules": "pnpm dlx rimraf@5.0.10 -g \"**/node_modules\"",
        "monorepo:clean:nx": "nx reset",
        "monorepo:clean:soft": "pnpm run monorepo:clean:tsbuildinfo && pnpm run monorepo:clean:eslintcache && pnpm run monorepo:clean:nx",
        "monorepo:clean:tsbuildinfo": "pnpm dlx rimraf@5.0.10 -g \"**/tsconfig.tsbuildinfo\"",
        "prepare": "husky",
        "setup:browsers": "playwright install chromium",
        "test": "nx run-many --target=test",
        "test:affected": "nx affected --target=test",
        "test:changed": "nx run-many --target=test:changed",
        "test:coverage": "nx run-many --target=test:coverage",
        "test:integration": "nx run-many --target=test:integration",
        "test:integration:affected": "nx affected --target=test:integration",
        "test:integration:watch": "nx run-many --target=test:integration:watch",
        "test:integration-platform": "nx run-many --target=test:integration-platform",
        "test:integration-platform:affected": "nx affected --target=test:integration-platform",
        "test:integration-platform:watch": "nx run-many --target=test:integration-platform:watch",
        "test:mutation": "nx run-many --target=test:mutation",
        "test:mutation:affected": "nx affected --target=test:mutation",
        "test:types": "nx run-many --target=test:types",
        "test:types:affected": "nx affected --target=test:types",
        "test:types:watch": "nx run-many --target=test:types:watch",
        "test:ui": "vitest --ui",
        "test:unit": "nx run-many --target=test:unit",
        "test:unit:affected": "nx affected --target=test:unit",
        "test:unit:watch": "nx run-many --target=test:unit:watch",
        "test:watch": "nx run-many --target=test:watch",
        "typecheck": "tsc --build tsconfig.node.json"
    },
    "devDependencies": {
        "@codecov/bundle-analyzer": "2.0.1",
        "@commitlint/cli": "21.2.2",
        "@commitlint/config-conventional": "21.2.2",
        "@commitlint/types": "21.2.0",
        "@eslint/js": "10.0.1",
        "@nx/js": "23.1.0",
        "@stryker-mutator/api": "catalog:",
        "@stryker-mutator/core": "catalog:",
        "@stryker-mutator/typescript-checker": "catalog:",
        "@stryker-mutator/vitest-runner": "catalog:",
        "@swc-node/register": "1.12.0",
        "@swc/core": "1.15.43",
        "@swc/helpers": "0.5.23",
        "@types/node": "catalog:",
        "@vitest/browser": "5.0.5",
        "@vitest/browser-playwright": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "@vitest/ui": "catalog:",
        "eslint": "10.7.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-boundaries": "7.2.0",
        "eslint-plugin-regexp": "3.1.1",
        "fallow": "3.31.0",
        "globals": "17.13.0",
        "husky": "9.1.7",
        "knip": "6.43.0",
        "lint-staged": "17.6.0",
        "markdownlint-cli": "0.49.1",
        "nx": "23.1.0",
        "oxfmt": "0.59.0",
        "playwright": "1.61.1",
        "stylelint": "17.16.0",
        "stylelint-config-standard": "40.0.0",
        "tslib": "catalog:",
        "typescript": "catalog:",
        "typescript-eslint": "8.64.0",
        "validate-branch-name": "1.3.2",
        "vitest": "catalog:"
    },
    "devEngines": {
        "runtime": [
            {
                "name": "node",
                "version": "24.21.0",
                "onFail": "download"
            }
        ]
    },
    "engines": {
        "node": "24.21.0",
        "pnpm": "12.14.0"
    },
    "packageManager": "pnpm@12.14.0",
    "nx": {
        "includedScripts": [
            "lint:fallow",
            "lint:legacy-tests",
            "lint:markdownlint",
            "typecheck"
        ]
    }
}
