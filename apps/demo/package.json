{
    "name": "@m0n0lab/demo",
    "version": "0.0.2",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc -b --clean && tsc -b && vite build",
        "dev": "vite",
        "lint:eslint": "eslint --cache --concurrency=auto --max-warnings 60 .",
        "lint:eslint:config-check": "eslint-config-prettier src/index.tsx",
        "lint:eslint:fix": "eslint --cache --concurrency=auto --max-warnings 60 --fix .",
        "lint:knip": "knip --max-issues 100",
        "lint:knip:fix": "knip --fix",
        "lint:oxfmt": "oxfmt --check .",
        "lint:oxfmt:fix": "oxfmt .",
        "preview": "vite preview"
    },
    "dependencies": {
        "solid-js": "catalog:"
    },
    "devDependencies": {
        "@codecov/vite-plugin": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vite-plugin-solid": "catalog:"
    },
    "engines": {
        "node": "24.18.0",
        "pnpm": "11.15.0"
    },
    "packageManager": "pnpm@11.15.0"
}
