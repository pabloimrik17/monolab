{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "module": "preserve",
        "moduleResolution": "bundler",
        "outDir": "./out-tsc/app",
        "rootDir": "./src",
        "tsBuildInfoFile": "./out-tsc/app/tsconfig.tsbuildinfo",
        "jsx": "preserve",
        "jsxImportSource": "solid-js",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "noUncheckedSideEffectImports": true
    },
    "include": ["src"]
}
