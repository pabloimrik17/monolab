# qup-web env template. Copy to .env and fill in.
# API_ADMIN_PIN must match apps/qup-api.
API_ADMIN_PIN=
# HMAC secret for the admin cookie. Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
QUP_AUTH_SECRET=
# Backend URL (defaults to http://localhost:3001 if unset).
QUP_API_URL=http://localhost:3001
