# qup-api env template. Copy to .env and fill in; Nx loads it for qup-api tasks.
# Also read by `docker compose` in this directory.
# Must match API_ADMIN_PIN in apps/qup-web/.env.
API_ADMIN_PIN=
# Matches the postgres service in docker-compose.yml.
DATABASE_URL=postgres://qup:qup@localhost:5432/qup
PORT=3001
