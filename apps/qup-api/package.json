{
    "name": "@m0n0lab/qup-api",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsdown",
        "dev": "tsx watch src/index.ts",
        "dev:migrate": "pnpm --filter @m0n0lab/qup-data db:migrate",
        "start": "node dist/index.mjs",
        "test": "vitest run",
        "test:changed": "vitest run --changed",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@hono/node-server": "2.0.10",
        "@m0n0lab/qup-data": "workspace:*",
        "@m0n0lab/qup-domain": "workspace:*",
        "@m0n0lab/qup-shared": "workspace:*",
        "drizzle-orm": "catalog:",
        "hono": "4.12.30",
        "inversify": "catalog:",
        "pg": "catalog:"
    },
    "devDependencies": {
        "@codecov/rollup-plugin": "catalog:",
        "@m0n0lab/vitest-config": "workspace:*",
        "@types/node": "catalog:",
        "tsdown": "catalog:",
        "tsx": "4.23.1",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": "24.21.0",
        "pnpm": "11.15.0"
    },
    "packageManager": "pnpm@11.15.0"
}
