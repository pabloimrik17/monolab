{
    "name": "@m0n0lab/qup-api",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm run build:typecheck && pnpm run build:lib",
        "build:lib": "tsdown",
        "build:typecheck": "tsc --noEmit",
        "dev": "tsx watch src/index.ts",
        "start": "node dist/index.js",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "test:unit:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@hono/node-server": "2.0.10",
        "@m0n0lab/qup-data": "workspace:*",
        "@m0n0lab/qup-domain": "workspace:*",
        "@m0n0lab/qup-shared": "workspace:*",
        "drizzle-orm": "catalog:",
        "hono": "4.12.30",
        "inversify": "catalog:",
        "pg": "catalog:"
    },
    "devDependencies": {
        "@codecov/rollup-plugin": "catalog:",
        "@types/node": "catalog:",
        "tsdown": "catalog:",
        "tsx": "4.23.1",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": "24.18.0",
        "pnpm": "11.15.0"
    },
    "packageManager": "pnpm@11.15.0"
}
