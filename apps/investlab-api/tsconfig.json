{
    "extends": ["../../tsconfig.base.json", "../../packages/ts-configs/tsconfig.node24.json"],
    "compilerOptions": {
        "module": "preserve",
        "moduleResolution": "bundler",
        "outDir": "./out-tsc",
        "rootDir": "./src",
        "declaration": true,
        "composite": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "types": ["node"],
        "paths": {
            "#app": ["./src/app.ts"],
            "#catalog/*": ["./src/catalog/*"],
            "#core/*": ["./src/core/*"],
            "#di/*": ["./src/di/*"],
            "#portfolio/*": ["./src/portfolio/*"],
            "#quotes/*": ["./src/quotes/*"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["**/*.test.ts", "**/*.spec.ts"],
    "references": [
      {
        "path": "../../packages/investlab-catalog"
      },
      {
        "path": "../../packages/investlab-quotes"
      },
      {
        "path": "../../packages/investlab-portfolio"
      },
      {
        "path": "../../packages/investlab-platform"
      },
      {
        "path": "../../packages/investlab-core"
      },
      {
        "path": "../../packages/vitest-config"
      },
      {
        "path": "./tsconfig.node.json"
      },
      {
        "path": "./tsconfig.test.json"
      }
    ]
}
