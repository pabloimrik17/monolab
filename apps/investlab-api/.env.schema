# investlab-api env schema (Varlock). `varlock run -- <cmd>` injects the resolved env.
#
# development (default): secrets resolve from 1Password via the desktop app (op://monolab-dev/investlab/*).
# ci (auto when CI): placeholder values from .env.ci; no 1Password, no secrets.
# production: set APP_ENV=production and provide values via the process env.
#
# @currentEnv=$APP_ENV
# @defaultRequired=true
# @defaultSensitive=false
# @plugin(@varlock/1password-plugin)
# @initOp(allowAppAuth=forEnv(development))
# ---

# @type=enum(development, ci, production)
APP_ENV=if($VARLOCK_IS_CI, ci, development)

# @type=port
PORT=3002

# Postgres. Matches apps/investlab/docker-compose.yml (host port 5433). Also used by db:migrate/db:generate.
# @sensitive
DATABASE_URL=postgres://investlab:investlab@localhost:5433/investlab

# Redis. Matches apps/investlab/docker-compose.yml.
REDIS_URL=redis://localhost:6379

# Finnhub API key (https://finnhub.io/register).
# @sensitive
FINNHUB_API_KEY=op(op://monolab-dev/investlab/finnhub-api-key)

# Shared secret; the same 1Password field feeds apps/investlab, so both sides always match.
# @sensitive
INVESTLAB_API_TOKEN=op(op://monolab-dev/investlab/api-token)
