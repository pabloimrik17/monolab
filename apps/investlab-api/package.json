{
    "name": "@m0n0lab/investlab-api",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsdown",
        "db:generate": "pnpm --filter @m0n0lab/investlab-database db:generate",
        "db:migrate": "pnpm --filter @m0n0lab/investlab-database db:migrate",
        "dev": "tsx watch src/index.ts",
        "lint:eslint": "eslint --cache --concurrency=auto --max-warnings 40 .",
        "lint:eslint:fix": "eslint --cache --concurrency=auto --max-warnings 40 --fix .",
        "start": "node dist/index.mjs",
        "test": "vitest run",
        "test:changed": "vitest run --changed",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "test:unit": "vitest run",
        "test:unit:changed": "vitest run --changed",
        "test:unit:watch": "vitest",
        "test:unit:coverage": "vitest run --coverage",
        "typecheck": "tsc --build tsconfig.json --emitDeclarationOnly"
    },
    "dependencies": {
        "@hono/node-server": "2.0.10",
        "@m0n0lab/investlab-core": "workspace:*",
        "@m0n0lab/investlab-platform": "workspace:*",
        "@m0n0lab/investlab-portfolio": "workspace:*",
        "@m0n0lab/investlab-quotes": "workspace:*",
        "@varlock/1password-plugin": "catalog:",
        "hono": "4.12.30",
        "inversify": "catalog:",
        "neverthrow": "catalog:",
        "varlock": "catalog:",
        "zod": "3.25.76"
    },
    "devDependencies": {
        "@codecov/rollup-plugin": "catalog:",
        "@m0n0lab/vitest-config": "workspace:*",
        "@types/node": "catalog:",
        "tsdown": "catalog:",
        "tsx": "4.23.1",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": "24.21.0",
        "pnpm": "11.15.0"
    },
    "packageManager": "pnpm@11.15.0"
}
