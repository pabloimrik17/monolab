# investlab-api env template. Copy to .env and fill in; Nx loads it for investlab-api tasks.
# Shared secret; must match INVESTLAB_API_TOKEN in apps/investlab.
INVESTLAB_API_TOKEN=
PORT=3002

# Postgres — matches apps/investlab/docker-compose.yml (host port 5433); also read by db:migrate/db:generate
DATABASE_URL=postgres://investlab:investlab@localhost:5433/investlab

# Redis — matches apps/investlab/docker-compose.yml
REDIS_URL=redis://localhost:6379

# Finnhub API key — get one free at https://finnhub.io/register
FINNHUB_API_KEY=
