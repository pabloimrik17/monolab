{
    "name": "@m0n0lab/investlab",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "pnpm run build:typecheck && pnpm run build:lib",
        "build:lib": "tsdown",
        "build:typecheck": "tsc --noEmit",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "test:unit:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@m0n0lab/investlab-core": "workspace:*",
        "@m0n0lab/investlab-data": "workspace:*",
        "@m0n0lab/investlab-domain": "workspace:*",
        "@m0n0lab/wealth-tracker-core": "workspace:*",
        "drizzle-orm": "0.45.2",
        "inversify": "8.1.3",
        "ioredis": "5.11.1",
        "pg": "8.21.0"
    },
    "devDependencies": {
        "@codecov/rollup-plugin": "2.0.1",
        "@types/pg": "8.20.0",
        "tsdown": "0.22.9",
        "typescript": "6.0.3",
        "vitest": "catalog:"
    },
    "engines": {
        "node": "24.18.0",
        "pnpm": "11.9.0"
    },
    "packageManager": "pnpm@11.9.0"
}
