{
    "name": "@m0n0lab/investlab",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "react-router build",
        "dev": "react-router dev",
        "lint:eslint": "eslint --cache --concurrency=auto --max-warnings 60 .",
        "lint:knip": "knip --max-issues 100",
        "start": "varlock run -- react-router-serve ./build/server/index.js",
        "test": "vitest run",
        "test:changed": "vitest run --changed",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "test:unit": "vitest run",
        "test:unit:changed": "vitest run --changed",
        "test:unit:watch": "vitest",
        "test:unit:coverage": "vitest run --coverage",
        "typecheck": "react-router typegen && tsc --noEmit && tsc --build tsconfig.node.json"
    },
    "dependencies": {
        "@m0n0lab/investlab-application-client": "workspace:*",
        "@m0n0lab/investlab-data-client": "workspace:*",
        "@m0n0lab/investlab-data-contracts": "workspace:*",
        "@m0n0lab/investlab-data-server": "workspace:*",
        "@m0n0lab/investlab-domain": "workspace:*",
        "@react-router/node": "8.2.0",
        "@react-router/serve": "8.2.0",
        "@varlock/1password-plugin": "catalog:",
        "inversify": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "react-router": "8.2.0",
        "varlock": "catalog:",
        "zod": "3.25.76"
    },
    "devDependencies": {
        "@codecov/vite-plugin": "catalog:",
        "@m0n0lab/vitest-config": "workspace:*",
        "@react-router/dev": "8.2.0",
        "@types/react": "catalog:",
        "@types/react-dom": "19.2.3",
        "@varlock/vite-integration": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": "24.18.0",
        "pnpm": "11.15.0"
    },
    "packageManager": "pnpm@11.15.0"
}
