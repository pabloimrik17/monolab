{
    "name": "@m0n0lab/investlab",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "react-router build",
        "dev": "react-router dev",
        "lint:eslint": "eslint --cache --concurrency=auto --max-warnings 60 .",
        "lint:knip": "knip --max-issues 60 --exclude catalogReferences",
        "lint:stylelint": "stylelint 'src/**/*.css'",
        "start": "varlock run -- react-router-serve ./build/server/index.js",
        "test": "vitest run",
        "test:changed": "vitest run --changed",
        "test:coverage": "vitest run --coverage",
        "test:integration-platform": "vitest run --project integration-platform",
        "test:integration-platform:changed": "vitest run --project integration-platform --changed",
        "test:integration-platform:coverage": "vitest run --project integration-platform --coverage",
        "test:integration-platform:watch": "vitest --project integration-platform",
        "test:unit": "vitest run --project unit",
        "test:unit:changed": "vitest run --project unit --changed",
        "test:unit:coverage": "vitest run --project unit --coverage",
        "test:unit:watch": "vitest --project unit",
        "test:watch": "vitest",
        "typecheck": "react-router typegen && tsc --noEmit && tsc --build tsconfig.node.json"
    },
    "dependencies": {
        "@m0n0lab/investlab-catalog": "workspace:*",
        "@m0n0lab/investlab-core": "workspace:*",
        "@m0n0lab/investlab-platform": "workspace:*",
        "@m0n0lab/investlab-portfolio": "workspace:*",
        "@m0n0lab/investlab-quotes": "workspace:*",
        "@m0n0lab/investlab-roger": "workspace:*",
        "@react-router/node": "8.2.0",
        "@react-router/serve": "8.2.0",
        "@varlock/1password-plugin": "catalog:",
        "inversify": "catalog:",
        "neverthrow": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "react-router": "8.3.0",
        "varlock": "catalog:",
        "zod": "3.25.76"
    },
    "devDependencies": {
        "@codecov/vite-plugin": "catalog:",
        "@m0n0lab/vitest-config": "workspace:*",
        "@react-router/dev": "8.2.0",
        "@types/react": "catalog:",
        "@types/react-dom": "19.2.3",
        "@varlock/vite-integration": "catalog:",
        "@vitest/browser-playwright": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "msw": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:",
        "vitest-browser-react": "catalog:"
    },
    "engines": {
        "node": "24.21.0",
        "pnpm": "12.14.0"
    },
    "packageManager": "pnpm@12.14.0"
}
