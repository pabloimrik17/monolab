# Postgres — matches apps/investlab/docker-compose.yml (host port 5433)
DATABASE_URL=postgres://investlab:investlab@localhost:5433/investlab

# Redis — matches apps/investlab/docker-compose.yml
REDIS_URL=redis://localhost:6379

# Finnhub API key — get one free at https://finnhub.io/register
# Server-side reads FINNHUB_API_KEY.
# Client-side ticker poller (app/lib/wealth.ts) reads VITE_FINNHUB_API_KEY.
# Set both to the same value in local dev.
FINNHUB_API_KEY=
VITE_FINNHUB_API_KEY=
