{
    "include": ["**/*.ts", "**/*.tsx", ".react-router/types/**/*"],
    "compilerOptions": {
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "rootDirs": [".", "./.react-router/types"],
        "outDir": "./dist",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "types": ["vite/client"],
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true
    },
    "references": [
      {
        "path": "../../packages/investlab-domain"
      },
      {
        "path": "../../packages/investlab-data-server"
      },
      {
        "path": "../../packages/investlab-application-server"
      },
      {
        "path": "../../packages/investlab-core"
      }
    ]
}
