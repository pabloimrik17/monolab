{
    "include": ["**/*.ts", "**/*.tsx", ".react-router/types/**/*"],
    "exclude": [
        "node_modules",
        "dist",
        "out-tsc",
        "react-router.config.ts",
        "vite.config.ts",
        "vitest.config.ts"
    ],
    "compilerOptions": {
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "rootDirs": [".", "./.react-router/types"],
        "outDir": "./dist",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "types": ["node", "vite/client"],
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true
    },
    "references": [
      {
        "path": "../../packages/investlab-data-contracts"
      },
      {
        "path": "../../packages/investlab-data-server"
      },
      {
        "path": "../../packages/investlab-application-server"
      },
      {
        "path": "../../packages/investlab-core"
      },
      {
        "path": "../../packages/vitest-config"
      }
    ]
}
