# investlab (web) env schema (Varlock). `varlock run -- <cmd>` / varlockVitePlugin inject the resolved env.
#
# development (default): secrets resolve from 1Password via the desktop app (op://monolab-dev/investlab/*).
# ci (auto when CI): placeholder values from .env.ci; no 1Password, no secrets.
# production: set APP_ENV=production and provide values via the process env.
#
# @currentEnv=$APP_ENV
# @defaultRequired=true
# @defaultSensitive=false
# @plugin(@varlock/1password-plugin)
# @initOp(allowAppAuth=forEnv(development))
# ---

# @type=enum(development, ci, production)
APP_ENV=if($VARLOCK_IS_CI, ci, development)

# Base URL of apps/investlab-api (port matches its PORT default).
# @type=url
INVESTLAB_API_URL=http://localhost:3002

# Bearer token for the API; same 1Password field as apps/investlab-api's INVESTLAB_API_TOKEN.
# @sensitive
INVESTLAB_API_TOKEN=op(op://monolab-dev/investlab/api-token)

# TEMPORARY (until 12.3): browser-side ticker poller (app/lib/wealth.ts) reads this, so it ships in the client
# bundle and cannot be @sensitive (it already is public today). Removed with the Finnhub-in-browser path.
VITE_FINNHUB_API_KEY=op(op://monolab-dev/investlab/finnhub-api-key)
