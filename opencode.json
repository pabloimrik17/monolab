{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "nx-mcp": {
            "type": "local",
            "command": ["pnpx", "nx-mcp@0.25.3"],
            "enabled": true
        },
        "eslint": {
            "type": "local",
            "command": ["pnpx", "@eslint/mcp@0.3.16"],
            "enabled": true
        },
        "context7": {
            "type": "local",
            "command": ["pnpx", "@upstash/context7-mcp@4.4.4"],
            "enabled": true
        },
        "knip": {
            "type": "local",
            "command": ["pnpx", "@knip/mcp@0.0.34"],
            "enabled": true
        },
        "memory": {
            "type": "local",
            "command": ["pnpx", "@modelcontextprotocol/server-memory@2026.8.31"],
            "enabled": true
        },
        "playwright": {
            "type": "local",
            "command": ["pnpx", "@playwright/mcp@0.0.79"],
            "enabled": true
        },
        "chrome-devtools": {
            "type": "local",
            "command": ["pnpx", "chrome-devtools-mcp@1.10.1"],
            "enabled": true
        },
        "gh_grep": {
            "type": "remote",
            "url": "https://mcp.grep.app"
        }
    }
}
